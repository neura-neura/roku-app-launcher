            <Label id="status" translation="[94,209]" width="1720" height="55" color="#C2D1E8"/>
            <Rectangle translation="[94,310]" width="1732" height="568" color="#1D293E"/>
            <LabelList id="menu" translation="[126,342]" itemSize="[1630,70]" numRows="7" vertFocusAnimationStyle="floatingFocus"/>
            <Label translation="[94,930]" width="1730" text="OK · Open       Back · Return       * · Server" color="#C2D1E8"/>
            <Label id="server" translation="[94,978]" width="1730" color="#67E8C8"/>
