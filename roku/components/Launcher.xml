        <field id="transportResponse" type="assocarray" alwaysNotify="true"/>
    </interface>
    <script type="text/brightscript" uri="Launcher.brs"/>
    <children>
        <Group id="home">
            <Rectangle width="1920" height="1080" color="#111827"/>
            <Rectangle translation="[94,90]" width="70" height="8" color="#67E8C8"/>
